# true = proposta dimostrativa (banner, segnalazioni dati da verificare, modulo che NON invia, noindex)
NEXT_PUBLIC_DEMO_MODE=true
# URL pubblico definitivo (per canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.zipauluccio.it
# Endpoint che riceve le richieste di prenotazione (es. Formspree, funzione serverless con Resend).
# Lasciare vuoto finché non è configurato: il modulo proporrà la chiamata telefonica.
NEXT_PUBLIC_BOOKING_ENDPOINT=
# ID Google Analytics 4 (caricato SOLO dopo consenso cookie)
NEXT_PUBLIC_GA_ID=
